shamefully-hoist=true
strict-peer-dependencies=false
# npm-native equivalent of the pnpm settings above. @nuxt/ui@4 + Nuxt 4's
# peer graph (vue-router 5 / transitive vite) trips npm's strict ERESOLVE;
# this keeps `npm install` and the deploy's `npm ci` resolving permissively.
legacy-peer-deps=true
