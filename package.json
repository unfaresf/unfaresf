{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "nuxt build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:update": "vitest -u",
    "test:coverage": "vitest --coverage",
    "test:e2e": "rm -f db/data/local-e2e.db* && dotenv -e .env.e2e -- drizzle-kit migrate --config=drizzle.config.ts && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start": "node .output/server/index.mjs",
    "dev": "npx nuxi@latest dev --no-fork",
    "dev:host": "npx nuxi@latest dev --no-fork --host 0.0.0.0",
    "dev:inspect": "npx nuxi@latest dev --inspect",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit up --config=drizzle.config.ts",
    "gtfs:init": "node ./gtfs/init.js",
    "gtfs:migrate": "drizzle-kit up --config=drizzle-gtfs.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@nuxt/devtools": "^4.0.0-alpha.7",
    "@nuxt/test-utils": "^3.19.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/device": "^3.2.4",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/sanitize-html": "^2.13.0",
    "@types/serviceworker": "^0.0.135",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitest/coverage-v8": "^3.1.3",
    "@vue/test-utils": "^2.4.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.7",
    "nuxt-authorization": "^0.3.2",
    "nuxt-cron": "^1.8.0",
    "nuxt-security": "^2.6.0",
    "playwright-core": "^1.52.0",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6",
    "vue": "latest",
    "vue-tsc": "^2.2.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@atproto/oauth-client-node": "^0.2.16",
    "@iconify-json/heroicons": "^1.2.2",
    "@indoorequal/vue-maplibre-gl": "^8.2.2",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@turf/turf": "^7.2.0",
    "@vueuse/core": "^13.2.0",
    "better-sqlite3": "^12.11.1",
    "consola": "^3.4.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "geojson": "^0.5.0",
    "gtfs": "^4.15.12",
    "maplibre-gl": "^5.1.0",
    "masto": "^6.10.2",
    "mitt": "^3.0.1",
    "sanitize-html": "^2.14.0",
    "tailwindcss": "^4.3.2",
    "uuid": "^11.0.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.5.6": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.32.6": true,
    "esbuild@0.27.7": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.2": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.18.20": true
  }
}
